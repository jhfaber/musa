{
  // Ctrl+Shift+B (o Terminal → Ejecutar tarea… → "Iniciar Musa") arranca el servidor de prueba.
  // La terminal muestra la dirección para el celular (mismo wifi). Se detiene con la papelera de la terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Musa",
      "type": "shell",
      "command": "node",
      "args": ["herramientas/servidor.js"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "musa",
        "pattern": { "regexp": "^__nunca__$" },
        "background": { "beginsPattern": "^Musa en", "endsPattern": "^Musa en" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      // Terminal → Ejecutar tarea… → "Publicar Musa": sube la app a https://jhfaber.github.io/musa/
      "label": "Publicar Musa",
      "type": "shell",
      "command": "node",
      "args": ["herramientas/publicar.js"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
